{
  "manifest_version": 3,
  "name": "BGA 7 Wonders Duel Advisor",
  "version": "0.1.0",
  "description": "Reads the live 7 Wonders Duel board on Board Game Arena and shows ranked moves from a local advisor.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sevenwondersduel-advisor@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.boardgamearena.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.boardgamearena.com/*"],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bga_snippet.js", "page_bridge.js"],
      "matches": ["*://*.boardgamearena.com/*"]
    }
  ]
}
