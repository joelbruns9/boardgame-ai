# Private settings - never share these
.env

# Data files - too large for GitHub, backed up separately
data/
!data/
data/*
!data/kingdomino/
data/kingdomino/*
!data/kingdomino/eval_suite_v1.jsonl

# Python
__pycache__/
*.py[cod]
*.pyd
*.pyo
.venv/
venv/
*.egg-info/

# Rust build artifacts
target/
*.so
Cargo.lock

# Reference papers (large PDFs kept locally, backed up separately)
references/

# Third-party BGA game source dumps (kept locally; not ours to redistribute).
# games/seven_wonders_duel/ADVISOR_IMPLEMENTATION_PLAN.md cites these by
# file:line -- the citations assume you have the dump at this path.
BGA Files/

# Checkpoints and large binary artifacts
checkpoints*/
*.pkl
# Exception: allow the best_checkpoint directory
!best_checkpoint/
!best_checkpoint/*.pt

# Training output (checkpoints, buffers, logs)
runs/

training_log_*.jsonl

# Training logs (large, machine-specific)
# Do NOT exclude elo_db.json or elo_games.jsonl — these are project
# artifacts that should be committed

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Temp test directories created during validation runs
tmp_*/
tmp/

# Tool scratch directories (MCP browser traces, agent working copies)
.playwright-mcp/
.codex-reply-pilot-fix/

# Claude local context
.claude/

# Ad-hoc experiment output dropped at the repo root (ablation sweeps, KL
# probes and their logs). These are run artifacts, not project artifacts.
/ablation_*.json
/ablation_*.log
/kl_*.json

# Model checkpoints staged into an extension folder for local testing.
extension_*/*.pt
